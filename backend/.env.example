# Environment Configuration
SERVER_PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgres://tcc:root@localhost:5432/tcc
DB_PORT=5432

# Auth Configuration
JWT_SECRET=jwt_secret
JWT_EXPIRES_IN=12h #in hours
REFRESH_JWT_SECRET=secret123
REFRESH_JWT_EXPIRES_IN=24h #in hours
SESSION_STORAGE_METHOD=database # database | redis
# 'database': apenas PostgreSQL.
# 'redis':    PostgreSQL como fonte da verdade + Redis como cache de leitura.
# Em ambos os modos as sessoes sobrevivem a queda do Redis.
SESSION_EXPIRES_IN=24h # in hours
COOKIE_EXPIRES_IN=12h # in hours
HASH_SALT_ROUNDS=10 # bcrypt salt rounds 

# Default admin Configuration
DEFAULT_ADMIN_USERNAME=admin123
DEFAULT_ADMIN_EMAIL=admin123@gmail.com
DEFAULT_ADMIN_PASSWORD=admin123

# Redis Configuration
REDIS_ENABLED=true # true or false — 'false' sobe a API sem Redis (sem cache e sem jobs)
REDIS_HOST=127.0.0.1  # If you are using a different host for Redis, change it accordingly 
REDIS_PORT=6379 # If you are using a different port for Redis, change it accordingly
REDIS_PASSWORD=null # 'null', 'none' ou vazio = sem senha

# Bull MQ 
BULLBOARD_PORT=3001


# ─── AbacatePay (gateway de pagamento) ───────────────────────────────────────
# Com ABACATEPAY_ENABLED=false a API sobe normalmente e as rotas de cobranca
# respondem 503. Nenhum destes valores chega ao aplicativo.
ABACATEPAY_ENABLED=false
ABACATEPAY_API_KEY=            # obrigatorio quando ABACATEPAY_ENABLED=true
ABACATEPAY_WEBHOOK_SECRET=     # o mesmo 'secret' cadastrado no webhook do painel
ABACATEPAY_BASE_URL=https://api.abacatepay.com/v2
ABACATEPAY_TIMEOUT=15000
ABACATEPAY_DEV_MODE=true       # sandbox: nao movimenta dinheiro real
# Para onde o checkout hospedado (cartao) devolve o usuario. Deep link do app.
ABACATEPAY_RETURN_URL=unipass://checkout/cancel
ABACATEPAY_COMPLETION_URL=unipass://checkout/success
ABACATEPAY_PIX_EXPIRES_IN_MINUTES=30
